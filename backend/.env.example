# ------------------------------------------------------------
# WKMS environment configuration
# ------------------------------------------------------------
# Copy this file to .env and replace placeholders locally.
# Never commit a real .env file or real credentials.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
#
# WKMS currently uses the `pg` PostgreSQL driver.
#
# For the shared Neon development database:
# - select the shared development branch
# - copy the Neon connection string
# - keep TLS certificate verification enabled
#
# Example only — never place real credentials in this file.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=verify-full&channel_binding=require